#!/usr/bin/env -S sbcl --script

(require :asdf)

(let* ((launcher-path (truename *load-truename*))
       (bin-directory (uiop:pathname-directory-pathname launcher-path))
       (source-root (uiop:pathname-parent-directory-pathname bin-directory))
       (project-setup
         (or (let ((override (uiop:getenv "AUTOLITH_PROJECT_SETUP")))
               (and override (plusp (length override)) (pathname override)))
             (merge-pathnames ".qlot/setup.lisp" source-root)))
       (user-setup (merge-pathnames "quicklisp/setup.lisp"
                                    (user-homedir-pathname)))
       (quicklisp-setup (if (probe-file project-setup)
                           project-setup
                           user-setup))
       (protocol-output *standard-output*))
  (let ((*standard-output* *error-output*)
        (*trace-output* *error-output*))
    (unless (probe-file quicklisp-setup)
      (error "Autolith search needs Quicklisp at ~A" quicklisp-setup))
    (load quicklisp-setup)
    (uiop:symbol-call '#:ql '#:quickload :cffi :silent t)
    (asdf:load-system :clifff))
  ;; clifff's :files operation renders decorated text. Inline completion needs
  ;; exact paths, including spaces and brackets. Extend only this child process.
  (let* ((dispatch (find-symbol "WORKER--DISPATCH" "CLIFFF"))
         (original (symbol-function dispatch)))
    (setf (symbol-function dispatch)
          (lambda (engine request)
            (if (eq (getf (rest request) :operation) :file-paths)
                (let* ((arguments (getf (rest request) :arguments))
                       (result (apply #'uiop:symbol-call
                                      '#:clifff '#:engine-search-files
                                      engine arguments)))
                  (with-standard-io-syntax
                    (write-to-string
                     (mapcar (lambda (item) (getf item :path))
                             (getf result :items)))))
                (funcall original engine request))))
    (unwind-protect
         (uiop:symbol-call '#:clifff '#:worker-main protocol-output)
      (setf (symbol-function dispatch) original))))
